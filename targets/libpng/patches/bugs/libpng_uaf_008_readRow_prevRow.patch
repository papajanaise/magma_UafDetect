    memcpy(png_ptr->prev_row, png_ptr->row_buf, row_info.rowbytes + 1);

+   /*
+    * BUG INJECTION (UAF-008):
+    * After copying current row into prev_row at row 127 during the last
+    * interlace pass (pass 6), free prev_row. The next row's filter
+    * operation will read from freed prev_row memory.
+    */
+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+   MAGMA_LOG("PNGUAF08", png_ptr->row_number == 127 && png_ptr->pass == 6);
+#endif
+   if (png_ptr->row_number == 127 && png_ptr->pass == 6) {
+      png_free(png_ptr, png_ptr->prev_row);
+      MAGMA_FREE_LOG("PNGUAF08");
+   }
+#endif
