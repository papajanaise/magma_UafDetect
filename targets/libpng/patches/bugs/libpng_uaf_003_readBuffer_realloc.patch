diff --git a/pngrutil.c b/pngrutil.c
index 2694fa72a..f798cda74 100644
--- a/pngrutil.c
+++ b/pngrutil.c
@@ -316,6 +316,25 @@ png_read_buffer(png_structrp png_ptr, png_alloc_size_t new_size, int warn)
          memset(buffer, 0, new_size); /* just in case */
          png_ptr->read_buffer = buffer;
          png_ptr->read_buffer_size = new_size;
+
+         /*
+          * BUG INJECTION (UAF-003):
+          * After the new read_buffer is allocated and assigned, free it
+          * for an exact size. png_ptr->read_buffer still points to
+          * the freed memory. All callers (png_handle_iCCP, png_handle_sPLT,
+          * etc.) will read/write into this freed buffer.
+          *
+          * Trigger: chunk requiring a read buffer of exactly 443 bytes.
+          */
+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+         MAGMA_LOG("PNGUAF03", new_size == 443);
+#endif
+         if (new_size == 443) {
+            png_free(png_ptr, buffer);
+            MAGMA_FREE_LOG("PNGUAF03");
+         }
+#endif
       }

       else if (warn < 2) /* else silent */
