From: UAF Injection Patch 001
Subject: [PATCH] UAF in dict.c: xmlDictAddString pool freed before memcpy

Vulnerability type : Use-After-Free
File               : dict.c
Function           : xmlDictAddString
Trigger            : namelen == 29 && name[0] == 'z' && name[4] == 'q'
Free site          : xmlFree(pool) after `ret = pool->free`
Use site           : memcpy(pool->free, name, namelen) dereferences freed pool
Difficulty         : hard

diff --git a/dict.c b/dict.c
index 90e4d814..7ef2e31f 100644
--- a/dict.c
+++ b/dict.c
@@ -283,6 +283,17 @@ xmlDictAddString(xmlDictPtr dict, const xmlChar *name, unsigned int namelen) {
     }
 found_pool:
     ret = pool->free;
+#ifndef MAGMA_ENABLE_FIXES
+    if (namelen == 29 && name[0] == 'z' && name[4] == 'q') {
+        xmlFree(pool);
+    }
+    MAGMA_FREE_LOG("XMLUAF01", namelen == 29 && name[0] == 'z' && name[4] == 'q');
+#endif
+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+    MAGMA_LOG("XMLUAF01", namelen == 29 && name[0] == 'z' && name[4] == 'q');
+#endif
+#endif
     memcpy(pool->free, name, namelen);
     pool->free += namelen;
     *(pool->free++) = 0;
