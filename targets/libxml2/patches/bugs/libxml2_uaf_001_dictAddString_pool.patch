From: UAF Injection Patch 001
Subject: [PATCH] UAF in dict.c: xmlDictAddString pool freed before memcpy

Vulnerability type : Use-After-Free
File               : dict.c
Function           : xmlDictAddString
Trigger            : namelen > 16 && namelen <= 32
Difficulty         : medium

diff --git a/dict.c b/dict.c
index 90e4d814..501977ee 100644
--- a/dict.c
+++ b/dict.c
@@ -283,6 +283,21 @@ xmlDictAddString(xmlDictPtr dict, const xmlChar *name, unsigned int namelen) {
     }
 found_pool:
     ret = pool->free;
+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+    MAGMA_LOG("XMLUAF01", namelen > 16 && namelen <= 32);
+    /*
+     * CANARY (XMLUAF01 free-reached):
+     * Newly allocated pool block is freed while 'pool' still points
+     * to it.  The memcpy below writes into freed memory (Pattern P1).
+     */
+    if (namelen > 16 && namelen <= 32)
+      MAGMA_FREE_LOG("XMLUAF01");
+#endif
+    if (namelen > 16 && namelen <= 32) {
+        xmlFree(pool);
+    }
+#endif
     memcpy(pool->free, name, namelen);
     pool->free += namelen;
     *(pool->free++) = 0;
