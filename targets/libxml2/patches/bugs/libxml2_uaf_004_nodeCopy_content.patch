From: UAF Injection Patch 004
Subject: [PATCH] UAF in tree.c: xmlNewDocPI frees cur->content; dangling escapes via return

Vulnerability type : Use-After-Free (free-reached canary; use occurs in caller)
File               : tree.c
Function           : xmlNewDocPI
Trigger            : xmlStrlen(cur->content) == 19 && cur->content[0] == 'Z' && cur->content[2] == 'q'
Free site          : xmlFree(cur->content) after assignment from xmlStrdup
Use site           : caller dereferences ret->content during tree traversal /
                     serialization / xmlAddChild callbacks; the predicate is
                     evaluated pre-free since the content bytes themselves are
                     needed to decide whether to fire the bug, and the cached
                     boolean is reused by both MAGMA_LOG and MAGMA_FREE_LOG so
                     the latter does not read freed memory.

diff --git a/tree.c b/tree.c
index c707f598..b04cff22 100644
--- a/tree.c
+++ b/tree.c
@@ -2209,6 +2209,23 @@ xmlNewDocPI(xmlDocPtr doc, const xmlChar *name, const xmlChar *content) {
     }
     cur->doc = doc;

+#ifndef MAGMA_ENABLE_FIXES
+    if (cur->content != NULL) {
+        int _uaf_len = xmlStrlen(cur->content);
+        /* Cache the predicate BEFORE xmlFree so MAGMA_FREE_LOG does not
+         * read freed memory (which would itself be a UAF and produce a
+         * spurious ASan report against the canary). */
+        int _uaf_trigger = (_uaf_len == 19 && cur->content[0] == 'Z' && cur->content[2] == 'q');
+#ifdef MAGMA_ENABLE_CANARIES
+        MAGMA_LOG("XMLUAF04", _uaf_trigger);
+#endif
+        if (_uaf_trigger) {
+            xmlFree(cur->content);
+        }
+        MAGMA_FREE_LOG("XMLUAF04", _uaf_trigger);
+    }
+#endif
+
     if ((__xmlRegisterCallbacks) && (xmlRegisterNodeDefaultValue))
 	xmlRegisterNodeDefaultValue((xmlNodePtr)cur);
     return(cur);
