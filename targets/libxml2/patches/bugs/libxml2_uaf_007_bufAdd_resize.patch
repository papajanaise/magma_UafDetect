From: UAF Injection Patch 007
Subject: [PATCH] UAF in buf.c: xmlBufAdd frees buf->content after resize; memmove writes freed buffer

Vulnerability type : Use-After-Free
File               : buf.c
Function           : xmlBufAdd
Trigger            : buf->use == 373 && len == 41
Free site          : xmlFree(buf->content) just after xmlBufResize
Use site           : memmove(&buf->content[buf->use], ...) — write through dangling buf->content

diff --git a/buf.c b/buf.c
index 24368d37..587c2b6e 100644
--- a/buf.c
+++ b/buf.c
@@ -903,8 +903,19 @@ xmlBufAdd(xmlBufPtr buf, const xmlChar *str, int len) {
 	    xmlBufMemoryError(buf, "growing buffer");
             return XML_ERR_NO_MEMORY;
         }
+#ifndef MAGMA_ENABLE_FIXES
+	if (buf->use == 373 && len == 41) {
+	    xmlFree(buf->content);
+	}
+	MAGMA_FREE_LOG("XMLUAF07", buf->use == 373 && len == 41);
+#endif
     }

+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+    MAGMA_LOG("XMLUAF07", buf->use == 373 && len == 41);
+#endif
+#endif
     memmove(&buf->content[buf->use], str, len*sizeof(xmlChar));
     buf->use += len;
     buf->content[buf->use] = 0;
