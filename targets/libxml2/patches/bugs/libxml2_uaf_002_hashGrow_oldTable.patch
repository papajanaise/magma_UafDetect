From: UAF Injection Patch 002
Subject: [PATCH] UAF in hash.c: xmlHashGrow double-free of old table

Vulnerability type : Use-After-Free (double free)
File               : hash.c
Function           : xmlHashGrow
Trigger            : oldsize == 8 && table->nbElems == 7 && size == 16
Difficulty         : hard

diff --git a/hash.c b/hash.c
index afa094ef..fde80ff2 100644
--- a/hash.c
+++ b/hash.c
@@ -307,6 +307,20 @@ xmlHashGrow(xmlHashTablePtr table, int size) {

     xmlFree(oldtable);

+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+    MAGMA_LOG("XMLUAF02", oldsize == 8 && table->nbElems == 7 && size == 16);
+#endif
+    /*
+     * CANARY (XMLUAF02): oldtable was already freed above.
+     * Freeing it again is a double-free (Pattern P7).
+     */
+    if (oldsize == 8 && table->nbElems == 7 && size == 16) {
+        xmlFree(oldtable);
+    }
+    MAGMA_FREE_LOG("XMLUAF02", oldsize == 8 && table->nbElems == 7 && size == 16);
+#endif
+
 #ifdef DEBUG_GROW
     xmlGenericError(xmlGenericErrorContext,
 	    "xmlHashGrow : from %d to %d, %d elems\n", oldsize, size, nbElem);
