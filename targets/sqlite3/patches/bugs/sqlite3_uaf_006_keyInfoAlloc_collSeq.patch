diff --git a/src/select.c b/src/select.c
index d368392..9088bd4 100644
--- a/src/select.c
+++ b/src/select.c
@@ -1387,6 +1387,22 @@ KeyInfo *sqlite3KeyInfoAlloc(sqlite3 *db, int N, int X){
     p->db = db;
     p->nRef = 1;
     memset(&p[1], 0, nExtra);
+    /*
+     * BUG INJECTION (UAF-006):
+     * When N == 13 and X == 1, free the KeyInfo immediately after
+     * allocation.  The caller will use the returned dangling pointer
+     * (immediate UAF).  N==13 requires an index or ORDER BY with
+     * exactly 13 key columns, which is very unusual.
+     */
+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+    MAGMA_LOG("SQLUAF06", N == 13 && X == 1);
+#endif
+    if( N == 13 && X == 1 ){
+      sqlite3DbFreeNN(db, p);
+      MAGMA_FREE_LOG("SQLUAF06");
+    }
+#endif
   }else{
     sqlite3OomFault(db);
   }
