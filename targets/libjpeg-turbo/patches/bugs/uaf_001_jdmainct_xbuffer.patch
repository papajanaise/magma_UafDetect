From: UAF Injection Patch 001
Subject: [PATCH] UAF in jdmainct.c: stale xbuffer pointer via early free in context mode

Vulnerability type : Use-After-Free
File               : jdmainct.c
Function           : alloc_funny_pointers (free site) / make_funny_pointers (use site)

diff --git a/jdmainct.c b/jdmainct.c
index f466b25..3f3d98f 100644
--- a/jdmainct.c
+++ b/jdmainct.c
@@ -19,6 +19,7 @@
 #include "jinclude.h"
 #include "jdmainct.h"
 #include "jconfigint.h"
+#include <stdlib.h>


 /*
@@ -163,5 +164,23 @@ alloc_funny_pointers(j_decompress_ptr cinfo)
     main_ptr->xbuffer[0][ci] = xbuf;
     xbuf += rgroup * (M + 4);
     main_ptr->xbuffer[1][ci] = xbuf;
   }
+
+  /*
+   * BUG INJECTION (UAF-001):
+   * When a restart interval is set and the image width is a multiple of 64,
+   * speculatively release xbuffer[0] assuming it will be rebuilt per-MCU.
+   * In practice it is NOT rebuilt; make_funny_pointers indexes into the
+   * freed array via main_ptr->xbuffer[0][ci].
+   */
+#ifndef MAGMA_ENABLE_FIXES
+  if (cinfo->restart_interval > 0 &&
+      (cinfo->image_width & 63) == 0 &&
+      cinfo->_min_DCT_scaled_size > 1) {
+    /* free the backing row-pointer array; pool allocator does not track this */
+    free(main_ptr->xbuffer[0]);
+    /* pointer is NOT nulled; dangling reference remains in xbuffer[0] */
+  }
+  MAGMA_FREE_LOG("JPGUAF01", cinfo->restart_interval > 0 && (cinfo->image_width & 63) == 0 && cinfo->_min_DCT_scaled_size > 1);
+#endif
 }


@@ -186,6 +205,11 @@ make_funny_pointers(j_decompress_ptr cinfo)
        ci++, compptr++) {
     rgroup = (compptr->v_samp_factor * compptr->_DCT_scaled_size) /
       cinfo->_min_DCT_scaled_size; /* height of a row group of component */
+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+    MAGMA_LOG("JPGUAF01", cinfo->restart_interval > 0 && (cinfo->image_width & 63) == 0 && cinfo->_min_DCT_scaled_size > 1);
+#endif
+#endif
     xbuf0 = main_ptr->xbuffer[0][ci];
     xbuf1 = main_ptr->xbuffer[1][ci];
     /* First copy the workspace pointers as-is */
