From: UAF Injection Patch 007
Subject: [PATCH] UAF in jdsample.c: stale chroma color_buf[1] after premature free

Vulnerability type : Use-After-Free
File               : jdsample.c
Function           : jinit_upsampler (free site) /
                     h2v2_fancy_upsample + h2v2_upsample (use sites)
Trigger            : cinfo->max_v_samp_factor == 2  (standard 4:2:0)

The injection frees upsample->color_buf[1] (the Cb chroma upsampling
workspace allocated by jinit_upsampler when need_buffer is TRUE) when
max_v_samp_factor == 2 (the standard 4:2:0 layout produced by nearly
every consumer JPEG encoder).  The pointer is not nulled, so the
chosen h2v2 chroma upsample method (h2v2_fancy_upsample or
h2v2_upsample) writes into the freed buffer through
upsample->color_buf[1] for every output row group, causing a heap
use-after-free.

Note: an earlier draft of this patch targeted color_buf[0] (Y), but
for 4:2:0 the Y component has need_buffer == FALSE so color_buf[0]
is never allocated, the free never runs, and the use-site canary
fires on a perfectly valid pointer set later by fullsize_upsample.
Targeting color_buf[1] (chroma), which IS heap-allocated by
jinit_upsampler, makes the bug actually fire and both canaries
correlate on the same input.

Pattern P2 (save-before-free): the per-row chroma scratch workspace is
freed out from under code that has already cached the address.

diff --git a/jdsample.c b/jdsample.c
index eaad72a..425cb5f 100644
--- a/jdsample.c
+++ b/jdsample.c
@@ -29,6 +29,7 @@
 #include "jdsample.h"
 #include "jsimd.h"
 #include "jpegcomp.h"
+#include <stdlib.h>



@@ -231,6 +232,12 @@ h2v2_upsample(j_decompress_ptr cinfo, jpeg_component_info *compptr,
               JSAMPARRAY input_data, JSAMPARRAY *output_data_ptr)
 {
   JSAMPARRAY output_data = *output_data_ptr;
+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+  /* h2v2_upsample writes through color_buf[1]/[2]; condition mirrors free-site */
+  MAGMA_LOG("JPGUAF07", cinfo->max_v_samp_factor == 2);
+#endif
+#endif
   register JSAMPROW inptr, outptr;
   register JSAMPLE invalue;
   JSAMPROW outend;
@@ -360,6 +367,12 @@ h2v2_fancy_upsample(j_decompress_ptr cinfo, jpeg_component_info *compptr,
                     JSAMPARRAY input_data, JSAMPARRAY *output_data_ptr)
 {
   JSAMPARRAY output_data = *output_data_ptr;
+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+  /* h2v2_fancy_upsample writes through color_buf[1]/[2]; condition mirrors free-site */
+  MAGMA_LOG("JPGUAF07", cinfo->max_v_samp_factor == 2);
+#endif
+#endif
   register JSAMPROW inptr0, inptr1, outptr;
 #if BITS_IN_JSAMPLE == 8
   register int thiscolsum, lastcolsum, nextcolsum;
@@ -521,4 +534,20 @@ jinit_upsampler(j_decompress_ptr cinfo)
          (JDIMENSION)cinfo->max_v_samp_factor);
     }
   }
+
+  /*
+   * BUG INJECTION (UAF-007):
+   * On standard 4:2:0 chroma-subsampled JPEGs (max_v_samp_factor == 2),
+   * free upsample->color_buf[1] (the Cb chroma scratch workspace
+   * allocated just above when need_buffer is TRUE).  The pointer is not
+   * nulled, so the chosen h2v2 chroma upsample method still writes into
+   * the freed buffer for every output row group.
+   */
+#ifndef MAGMA_ENABLE_FIXES
+  if (cinfo->max_v_samp_factor == 2 && upsample->color_buf[1] != NULL) {
+    free(upsample->color_buf[1]);
+    /* pointer is NOT nulled - dangling reference remains in color_buf[1] */
+  }
+  MAGMA_FREE_LOG("JPGUAF07", cinfo->max_v_samp_factor == 2 && upsample->color_buf[1] != NULL);
+#endif
 }
