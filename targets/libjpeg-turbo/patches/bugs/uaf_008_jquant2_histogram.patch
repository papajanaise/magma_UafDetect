From: UAF Injection Patch 008
Subject: [PATCH] UAF in jdmaster.c: stale sample_range_limit after premature free

Vulnerability type : Use-After-Free
File               : jdmaster.c
Function           : prepare_range_limit_table (free site) /
                     master_selection->jinit_color_deconverter (use site)
Trigger            : (cinfo->image_height & 1) == 1
Difficulty         : Low - any JPEG with odd image height triggers it

The injection adds a conditional free() of the sample_range_limit lookup
table inside prepare_range_limit_table() when the JPEG image height is
odd.  cinfo->sample_range_limit is NOT nulled, so every color converter
(jdcolext.c, jdmrgext.c, jdcol565.c, jdmrg565.c, jidctflt.c, etc.) that
later does `range_limit = cinfo->sample_range_limit;` and dereferences
it during pixel emission reads freed memory.

The MAGMA_LOG fires just before the jinit_color_deconverter() call in
master_selection() - the registration site for the callbacks that
capture the freed pointer (still ordered after the free).

Note: <stdlib.h> is supplied by the uaf_004 jdmaster.c patch which always
applies before this one (lexicographic patch ordering).

diff --git a/jdmaster.c b/jdmaster.c
index a3690bf..4e6e8aa 100644
--- a/jdmaster.c
+++ b/jdmaster.c
@@ -428,6 +428,24 @@ prepare_range_limit_table(j_decompress_ptr cinfo)
   /* Second half of post-IDCT table */
   memset(table + (2 * (MAXJSAMPLE + 1)), 0,
          (2 * (MAXJSAMPLE + 1) - CENTERJSAMPLE) * sizeof(JSAMPLE));
   memcpy(table + (4 * (MAXJSAMPLE + 1) - CENTERJSAMPLE),
          cinfo->sample_range_limit, CENTERJSAMPLE * sizeof(JSAMPLE));
+
+  /*
+   * BUG INJECTION (UAF-008):
+   * On JPEGs with an odd image_height, free the sample_range_limit
+   * lookup-table backing store as if a realloc-style resize were about
+   * to take place.  cinfo->sample_range_limit still holds the old
+   * offset-adjusted base, so every color converter that caches
+   * `range_limit = cinfo->sample_range_limit` reads freed memory.
+   * We back-offset by (MAXJSAMPLE + 1) to recover the genuine
+   * alloc_small() return value.
+   */
+#ifndef MAGMA_ENABLE_FIXES
+  if ((cinfo->image_height & 1) == 1 && cinfo->sample_range_limit != NULL) {
+    free((void *)(cinfo->sample_range_limit - (MAXJSAMPLE + 1)));
+    /* pointer is NOT nulled - dangling reference remains in cinfo->sample_range_limit */
+  }
+  MAGMA_FREE_LOG("JPGUAF08", (cinfo->image_height & 1) == 1 && cinfo->sample_range_limit != NULL);
+#endif
 }
@@ -525,6 +543,11 @@ master_selection(j_decompress_ptr cinfo)
       ERREXIT(cinfo, JERR_NOT_COMPILED);
 #endif
     } else {
+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+      MAGMA_LOG("JPGUAF08", (cinfo->image_height & 1) == 1 && cinfo->sample_range_limit != NULL);
+#endif
+#endif
       jinit_color_deconverter(cinfo);
       jinit_upsampler(cinfo);
     }
