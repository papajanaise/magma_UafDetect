From: UAF Injection Patch 010
Subject: [PATCH] UAF in jdapimin.c: stale marker_list after premature free

Vulnerability type : Use-After-Free
File               : jdapimin.c
Function           : jpeg_consume_input
Trigger            : cinfo->marker_list != NULL when SOS is reached
Difficulty         : Medium - requires JPEG with APP/COM markers before SOS

The injection adds a conditional free() of cinfo->marker_list inside
jpeg_consume_input() after the SOS marker is reached and default params
are set.  The marker_list pointer is not nulled, so subsequent calls to
jpeg_read_header or jpeg_finish_decompress that walk the marker list
dereference freed memory.
Pattern P3 (flag not updated).

--- a/jdapimin.c
+++ b/jdapimin.c
@@ -24,6 +24,7 @@
 #include "jpeglib.h"
 #include "jdmaster.h"
 #include "jconfigint.h"
+#include <stdlib.h>
 
 
 /*
@@ -317,6 +318,25 @@
       default_decompress_parms(cinfo);
       /* Set global state: ready for start_decompress */
       cinfo->global_state = DSTATE_READY;
+
+      /*
+       * BUG INJECTION (UAF-010):
+       * After reaching SOS and setting defaults, conditionally free
+       * marker_list assuming it is no longer needed.  The pointer is
+       * not nulled, so any subsequent access to saved markers (e.g.
+       * via jpeg_read_header retry or application code) will read
+       * freed memory.
+       */
+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+      MAGMA_LOG("JPGUAF10", cinfo->marker_list != NULL);
+#endif
+      if (cinfo->marker_list != NULL) {
+        free(cinfo->marker_list);
+        MAGMA_FREE_LOG("JPGUAF10");
+        /* pointer is NOT nulled -- dangling reference remains */
+      }
+#endif
     }
     break;
   case DSTATE_READY:
