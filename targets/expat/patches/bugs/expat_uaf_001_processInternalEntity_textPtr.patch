From: UAF Injection Patch 001
Subject: [PATCH] UAF in xmlparse.c: freed entity->textPtr read in processInternalEntity

Vulnerability type : Use-After-Free
File               : expat/lib/xmlparse.c
Function           : processInternalEntity

--- a/expat/lib/xmlparse.c
+++ b/expat/lib/xmlparse.c
@@ -5755,4 +5755,25 @@ processInternalEntity(XML_Parser parser, ENTITY *entity, XML_Bool betweenDecl) {
   textStart = (const char *)entity->textPtr;
   textEnd = (const char *)(entity->textPtr + entity->textLen);
+  /*
+   * BUG INJECTION (UAF-001):
+   * When the entity replacement text is exactly 8 XML_Chars, directly
+   * free() the string buffer that backs entity->textPtr.  The pool
+   * does not know about this deallocation.  textStart / textEnd remain
+   * set, so the XmlTok call below reads from freed memory.
+   *
+   * Trigger:
+   *   <!DOCTYPE r [
+   *     <!ENTITY x "12345678">   <!-- exactly 8 chars -->
+   *   ]>
+   *   <r>&x;</r>
+   */
+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+  MAGMA_LOG("EXPUAF01", entity->textLen == 8);
+#endif
+  if (entity->textLen == 8) {
+    free((void *)entity->textPtr);
+  }
+#endif
   /* Set a safe default value in case 'next' does not get set */
   next = textStart;
