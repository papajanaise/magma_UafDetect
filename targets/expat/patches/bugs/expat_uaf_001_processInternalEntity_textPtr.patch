From: UAF Injection Patch 001
Subject: [PATCH] UAF in xmlparse.c: freed entity->textPtr read in internalEntityProcessor

Vulnerability type : Use-After-Free
File               : expat/lib/xmlparse.c
Function           : internalEntityProcessor
Trigger            : entity->textLen == 8
Free site          : after textStart/textEnd are cached from entity->textPtr
Use site           : XmlPrologTok / doContent dereference textStart..textEnd

--- a/expat/lib/xmlparse.c
+++ b/expat/lib/xmlparse.c
@@ -6154,9 +6154,20 @@
   if (entity->hasMore) {
     textStart = ((const char *)entity->textPtr) + entity->processed;
     textEnd = (const char *)(entity->textPtr + entity->textLen);
+#ifndef MAGMA_ENABLE_FIXES
+    if (entity->textLen == 8) {
+      free((void *)entity->textPtr);
+    }
+    MAGMA_FREE_LOG("EXPUAF01", entity->textLen == 8);
+#endif
     /* Set a safe default value in case 'next' does not get set */
     next = textStart;

+#ifndef MAGMA_ENABLE_FIXES
+#ifdef MAGMA_ENABLE_CANARIES
+    MAGMA_LOG("EXPUAF01", entity->textLen == 8);
+#endif
+#endif
     if (entity->is_param) {
       int tok
           = XmlPrologTok(parser->m_internalEncoding, textStart, textEnd, &next);
