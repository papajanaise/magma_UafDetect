diff --git a/expat/lib/xmlparse.c b/expat/lib/xmlparse.c
--- a/expat/lib/xmlparse.c
+++ b/expat/lib/xmlparse.c
@@ -2814,8 +2814,14 @@ contentProcessor(XML_Parser parser, const char *start, const char *end,
       endPtr, (XML_Bool)! parser->m_parsingStatus.finalBuffer,
       XML_ACCOUNT_DIRECT);
+#ifdef MAGMA_ENABLE_FIXES
   if (result == XML_ERROR_NONE) {
     if (! storeRawNames(parser))
       return XML_ERROR_NO_MEMORY;
   }
+#else
+#ifdef MAGMA_ENABLE_CANARIES
+  MAGMA_LOG("%MAGMA_BUG%", result == XML_ERROR_NONE);
+#endif
+#endif
   return result;
 }
@@ -7782,5 +7788,13 @@ poolGrow(STRING_POOL *pool) {
     temp = (BLOCK *)pool->mem->realloc_fcn(pool->blocks,
                                            (unsigned)bytesToAllocate);
+    /*
+     * CANARY (CVE-2022-40674 free-reached):
+     * realloc_fcn freed the old pool block.  Any cached pointer into the
+     * old block (e.g. tag->rawName in the tag stack) is now dangling.
+     */
+#ifdef MAGMA_ENABLE_CANARIES
+    MAGMA_FREE_LOG("%MAGMA_BUG%", temp != NULL && temp != pool->blocks);
+#endif
     if (temp == NULL)
       return XML_FALSE;
     pool->blocks = temp;
